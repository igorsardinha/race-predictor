# ==============================================================================
# RACE PREDICTOR PRO - VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env.local e preencha suas chaves:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Strava API (OAuth 2.0)
# Obtenha suas credenciais em: https://www.strava.com/settings/api
# Em "Authorization Callback Domain", configure: localhost (ou o domínio do seu deploy)
# ------------------------------------------------------------------------------
STRAVA_CLIENT_ID=seu_strava_client_id_aqui
STRAVA_CLIENT_SECRET=seu_strava_client_secret_aqui

# ------------------------------------------------------------------------------
# 2. Configurações da Aplicação
# ------------------------------------------------------------------------------
PORT=3050
NEXT_PUBLIC_APP_URL=http://localhost:3050
